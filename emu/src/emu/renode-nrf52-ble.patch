diff --git a/src/Emulator/Peripherals/Peripherals/Wireless/SX1262.cs b/src/Emulator/Peripherals/Peripherals/Wireless/SX1262.cs
new file mode 100644
index 000000000..069f2786d
--- /dev/null
+++ b/src/Emulator/Peripherals/Peripherals/Wireless/SX1262.cs
@@ -0,0 +1,254 @@
+//
+// Semtech SX1262 (LoRa mode) behavioural model for firmware emulation.
+//
+// - SPI command framing follows NSS (GPIO input 0); RESET is GPIO input 1.
+// - BUSY is never asserted (commands complete instantly), so it need not be wired.
+// - IRQ output = DIO1 (IrqStatus & DIO1 mask).
+// - Every SX1262 in the process shares one "air": a TX is delivered, after its
+//   time on air, to every other instance in RX on the same frequency/SF/BW.
+//
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+
+using Antmicro.Renode.Core;
+using Antmicro.Renode.Logging;
+using Antmicro.Renode.Peripherals.SPI;
+using Antmicro.Renode.Time;
+
+namespace Antmicro.Renode.Peripherals.Wireless
+{
+    public sealed class SX1262 : ISPIPeripheral, IGPIOReceiver
+    {
+        public SX1262(IMachine machine)
+        {
+            this.machine = machine;
+            IRQ = new GPIO();
+            lock(Air) { Air.Add(this); }
+            Reset();
+        }
+
+        public GPIO IRQ { get; }
+
+        // Received-signal figures reported for every delivered packet.
+        public int RssiDbm { get; set; } = -60;
+        public int SnrDb { get; set; } = 10;
+
+        public void Reset()
+        {
+            regs = new byte[0x1000];
+            var version = Encoding.ASCII.GetBytes("SX1261 V2D 2D02\0");
+            Array.Copy(version, 0, regs, 0x320, version.Length);
+            regs[0x740] = 0x14; regs[0x741] = 0x24;   // LoRa sync word (private)
+            regs[0x8E7] = 0x18;                       // OCP
+            buffer = new byte[256];
+            cmd.Clear();
+            irq = 0; dio1Mask = 0;
+            mode = Mode.StandbyRc;
+            UpdateIrq();
+        }
+
+        public void OnGPIO(int number, bool value)
+        {
+            if(number == 0)
+            {
+                if(value && !nss) { /* deselected */ Execute(); }
+                if(!value) { cmd.Clear(); }
+                nss = value;
+            }
+            else if(number == 1 && value && !resetLine)
+            {
+                Reset();
+            }
+            if(number == 1) resetLine = value;
+        }
+
+        public byte Transmit(byte data)
+        {
+            var idx = cmd.Count;
+            cmd.Add(data);
+            return Respond(idx);
+        }
+
+        public void FinishTransmission()
+        {
+            // Framing is done on NSS; nothing to do per DMA transfer.
+        }
+
+        private byte Status => (byte)(((int)mode << 4) | (0x2 << 1));
+
+        private byte Respond(int idx)
+        {
+            if(idx == 0) return Status;
+            var op = cmd[0];
+            switch(op)
+            {
+            case 0xC0: return Status;                                    // GetStatus
+            case 0x11: return idx == 1 ? Status : (byte)packetType;      // GetPacketType
+            case 0x12:                                                   // GetIrqStatus
+                if(idx == 1) return Status;
+                return idx == 2 ? (byte)(irq >> 8) : (byte)irq;
+            case 0x13:                                                   // GetRxBufferStatus
+                if(idx == 1) return Status;
+                return idx == 2 ? rxLength : rxStart;
+            case 0x14:                                                   // GetPacketStatus
+                if(idx == 1) return Status;
+                if(idx == 2) return (byte)(-RssiDbm * 2);
+                if(idx == 3) return (byte)(sbyte)(SnrDb * 4);
+                return (byte)(-RssiDbm * 2);
+            case 0x15:                                                   // GetRssiInst
+                return idx == 1 ? Status : (byte)240;                    // -120 dBm
+            case 0x10:                                                   // GetStats
+            case 0x17:                                                   // GetDeviceErrors
+                return idx == 1 ? Status : (byte)0;
+            case 0x1D:                                                   // ReadRegister A1 A0 NOP data...
+                if(idx < 4) return Status;
+                return regs[(RegAddr() + idx - 4) & 0xFFF];
+            case 0x1E:                                                   // ReadBuffer offset NOP data...
+                if(idx < 3) return Status;
+                return buffer[(cmd[1] + idx - 3) & 0xFF];
+            default:
+                return Status;
+            }
+        }
+
+        private int RegAddr() => (cmd[1] << 8) | cmd[2];
+
+        private void Execute()
+        {
+            if(cmd.Count == 0) return;
+            var op = cmd[0];
+            var p = cmd.Skip(1).ToArray();
+            switch(op)
+            {
+            case 0x80: mode = p.Length > 0 && p[0] == 1 ? Mode.StandbyXosc : Mode.StandbyRc; break;   // SetStandby
+            case 0x84: mode = Mode.StandbyRc; break;                                                   // SetSleep
+            case 0xC1: mode = Mode.Fs; break;                                                          // SetFs
+            case 0x8A: if(p.Length > 0) packetType = p[0]; break;                                      // SetPacketType
+            case 0x86: if(p.Length >= 4) frequency = (uint)(p[0] << 24 | p[1] << 16 | p[2] << 8 | p[3]); break;
+            case 0x8B: if(p.Length >= 4) { sf = p[0]; bw = p[1]; cr = p[2]; ldro = p[3]; } break;     // SetModulationParams
+            case 0x8C: if(p.Length >= 6) { preamble = p[0] << 8 | p[1]; implicitHeader = p[2] == 1; payloadLength = p[3]; } break;
+            case 0x8F: if(p.Length >= 2) { txBase = p[0]; rxBase = p[1]; } break;                   // SetBufferBaseAddress
+            case 0x08: if(p.Length >= 4) { dio1Mask = (ushort)(p[2] << 8 | p[3]); UpdateIrq(); } break; // SetDioIrqParams
+            case 0x02: if(p.Length >= 2) { irq &= (ushort)~(p[0] << 8 | p[1]); UpdateIrq(); } break; // ClearIrqStatus
+            case 0x0D:                                                                                 // WriteRegister
+                for(var i = 2; i < p.Length; i++) regs[(RegAddr() + i - 2) & 0xFFF] = p[i];
+                break;
+            case 0x0E:                                                                                 // WriteBuffer
+                for(var i = 1; i < p.Length; i++) buffer[(p[0] + i - 1) & 0xFF] = p[i];
+                break;
+            case 0x83: StartTx(); break;                                                               // SetTx
+            case 0x82:                                                                                 // SetRx
+                mode = Mode.Rx;
+                rxSingle = p.Length >= 3 && (p[0] << 16 | p[1] << 8 | p[2]) != 0xFFFFFF;
+                break;
+            case 0xC5:                                                                                 // SetCAD
+                mode = Mode.Rx;
+                machine.ScheduleAction(TimeInterval.FromMicroseconds((ulong)(SymbolMs() * 4000)), _ =>
+                {
+                    mode = Mode.StandbyRc;
+                    Raise(IrqCadDone);
+                });
+                break;
+            default:
+                break;
+            }
+            cmd.Clear();
+        }
+
+        private void StartTx()
+        {
+            mode = Mode.Tx;
+            var len = payloadLength;
+            var frame = new byte[len];
+            for(var i = 0; i < len; i++) frame[i] = buffer[(txBase + i) & 0xFF];
+            var toa = TimeOnAirMs(len);
+            this.Log(LogLevel.Info, "LoRa TX {0} bytes f={1} sf={2} bw={3} toa={4:F1}ms", len, frequency, sf, bw, toa);
+            var key = (frequency, sf, bw);
+            machine.ScheduleAction(TimeInterval.FromMicroseconds((ulong)(toa * 1000)), _ =>
+            {
+                mode = Mode.StandbyRc;
+                Raise(IrqTxDone);
+                List<SX1262> peers;
+                lock(Air) { peers = Air.Where(r => r != this).ToList(); }
+                foreach(var r in peers)
+                {
+                    r.machine.LocalTimeSource.ExecuteInNearestSyncedState(__ => r.Deliver(key, frame));
+                }
+            });
+        }
+
+        private void Deliver((uint, byte, byte) key, byte[] frame)
+        {
+            if(mode != Mode.Rx || (frequency, sf, bw) != key)
+            {
+                return;
+            }
+            for(var i = 0; i < frame.Length; i++) buffer[(rxBase + i) & 0xFF] = frame[i];
+            rxStart = rxBase;
+            rxLength = (byte)frame.Length;
+            if(rxSingle) mode = Mode.StandbyRc;
+            this.Log(LogLevel.Info, "LoRa RX {0} bytes", frame.Length);
+            Raise(IrqPreamble | IrqHeaderValid | IrqRxDone);
+        }
+
+        private void Raise(ushort bits)
+        {
+            irq |= bits;
+            UpdateIrq();
+        }
+
+        private void UpdateIrq() => IRQ.Set((irq & dio1Mask) != 0);
+
+
+        private double BandwidthKhz()
+        {
+            switch(bw)
+            {
+            case 0x00: return 7.81; case 0x08: return 10.42; case 0x01: return 15.63; case 0x09: return 20.83;
+            case 0x02: return 31.25; case 0x0A: return 41.67; case 0x03: return 62.5; case 0x04: return 125;
+            case 0x05: return 250; case 0x06: return 500; default: return 125;
+            }
+        }
+
+        private double SymbolMs() => Math.Pow(2, Math.Max((int)sf, 5)) / BandwidthKhz();
+
+        private double TimeOnAirMs(int len)
+        {
+            var s = Math.Max((int)sf, 5);
+            var de = ldro != 0 ? 1 : 0;
+            var ih = implicitHeader ? 1 : 0;
+            var c = Math.Max((int)cr, 1);
+            var n = 8 + Math.Max(Math.Ceiling((8.0 * len - 4 * s + 28 + 16 - 20 * ih) / (4.0 * (s - 2 * de))) * (c + 4), 0);
+            return (preamble + 4.25 + n) * SymbolMs();
+        }
+
+        private enum Mode { StandbyRc = 2, StandbyXosc = 3, Fs = 4, Rx = 5, Tx = 6 }
+
+        private const ushort IrqTxDone = 1 << 0;
+        private const ushort IrqRxDone = 1 << 1;
+        private const ushort IrqPreamble = 1 << 2;
+        private const ushort IrqHeaderValid = 1 << 4;
+        private const ushort IrqCadDone = 1 << 7;
+
+        private static readonly List<SX1262> Air = new List<SX1262>();
+
+        private readonly IMachine machine;
+        private readonly List<byte> cmd = new List<byte>();
+        private byte[] regs;
+        private byte[] buffer;
+        private Mode mode;
+        private bool nss = true;
+        private bool resetLine = true;
+        private ushort irq, dio1Mask;
+        private byte packetType = 1;
+        private uint frequency;
+        private byte sf = 7, bw = 4, cr = 1, ldro;
+        private int preamble = 8;
+        private bool implicitHeader;
+        private byte payloadLength = 255;
+        private byte txBase, rxBase, rxStart, rxLength;
+        private bool rxSingle;
+    }
+}
