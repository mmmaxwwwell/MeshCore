diff --git a/src/Emulator/Peripherals/Peripherals/Miscellaneous/NRF52840_QSPI.cs b/src/Emulator/Peripherals/Peripherals/Miscellaneous/NRF52840_QSPI.cs
new file mode 100644
index 000000000..7c404c173
--- /dev/null
+++ b/src/Emulator/Peripherals/Peripherals/Miscellaneous/NRF52840_QSPI.cs
@@ -0,0 +1,219 @@
+//
+// nRF52840 QSPI controller with an attached NOR flash (default: P25Q16H, 2 MiB).
+// Tasks complete instantly and raise EVENTS_READY. Flash semantics: program ANDs
+// bits, erase sets 0xFF. The XIP window (0x12000000) is not modelled.
+// LoadImage/SaveImage move the flash contents to and from a host file.
+//
+using System;
+using System.Collections.Generic;
+using System.IO;
+
+using Antmicro.Renode.Core;
+using Antmicro.Renode.Logging;
+using Antmicro.Renode.Peripherals.Bus;
+
+namespace Antmicro.Renode.Peripherals.Miscellaneous
+{
+    public sealed class NRF52840_QSPI : IDoubleWordPeripheral, IKnownSize
+    {
+        public NRF52840_QSPI(IMachine machine, int flashSize = 0x200000, uint jedecId = 0x156085)
+        {
+            sysbus = machine.GetSystemBus(this);
+            this.jedecId = jedecId;
+            flash = new byte[flashSize];
+            for(var i = 0; i < flash.Length; i++) flash[i] = 0xFF;
+            IRQ = new GPIO();
+            Reset();
+        }
+
+        public long Size => 0x1000;
+        public GPIO IRQ { get; }
+
+        public void LoadImage(string path)
+        {
+            var data = File.ReadAllBytes(path);
+            Array.Copy(data, flash, Math.Min(data.Length, flash.Length));
+            this.Log(LogLevel.Info, "loaded {0} bytes from {1}", data.Length, path);
+        }
+
+        // Backing file: loaded when set (if it exists), then rewritten every 5 s while dirty,
+        // so the flash contents survive emulator restarts.
+        public string ImagePath
+        {
+            get => imagePath;
+            set
+            {
+                imagePath = value;
+                if(File.Exists(value)) LoadImage(value);
+                autosave?.Dispose();
+                autosave = new System.Threading.Timer(_ => { if(dirty) { dirty = false; SaveImage(imagePath); } }, null, 5000, 5000);
+            }
+        }
+
+        public void SaveImage(string path)
+        {
+            var tmp = path + ".tmp";
+            File.WriteAllBytes(tmp, flash);
+            File.Move(tmp, path, true);
+            this.Log(LogLevel.Info, "saved {0} bytes to {1}", flash.Length, path);
+        }
+
+        public void Reset()
+        {
+            regs.Clear();
+            sr1 = 0; sr2 = 0x02;   // QE set
+            IRQ.Unset();
+        }
+
+        public uint ReadDoubleWord(long offset)
+        {
+            switch(offset)
+            {
+            case IntEnClr: return Get(IntEn);
+            case IntEnSet: return Get(IntEn);
+            case Status: return (1u << 3) | ((uint)sr1 << 24);   // READY, SREG
+            default: return Get(offset);
+            }
+        }
+
+        public void WriteDoubleWord(long offset, uint value)
+        {
+            switch(offset)
+            {
+            case TaskActivate:
+            case TaskDeactivate:
+                if(value != 0) Ready();
+                return;
+            case TaskReadStart:
+                if(value != 0) { Read(); Ready(); }
+                return;
+            case TaskWriteStart:
+                if(value != 0) { Write(); Ready(); }
+                return;
+            case TaskEraseStart:
+                if(value != 0) { Erase(); Ready(); }
+                return;
+            case EventReady:
+                regs[offset] = value;
+                Update();
+                return;
+            case IntEn:
+                regs[IntEn] = value; Update(); return;
+            case IntEnSet:
+                regs[IntEn] = Get(IntEn) | value; Update(); return;
+            case IntEnClr:
+                regs[IntEn] = Get(IntEn) & ~value; Update(); return;
+            case CinstrConf:
+                regs[offset] = value;
+                CustomInstruction(value);
+                Ready();
+                return;
+            default:
+                regs[offset] = value;
+                return;
+            }
+        }
+
+        private uint Get(long o) => regs.TryGetValue(o, out var v) ? v : 0;
+
+        private void Ready()
+        {
+            regs[EventReady] = 1;
+            Update();
+        }
+
+        private void Update() => IRQ.Set(Get(EventReady) != 0 && (Get(IntEn) & 1) != 0);
+
+        private void Read()
+        {
+            var src = (int)Get(ReadSrc);
+            var cnt = (int)Get(ReadCnt);
+            var data = new byte[cnt];
+            for(var i = 0; i < cnt; i++) data[i] = flash[(src + i) % flash.Length];
+            sysbus.WriteBytes(data, Get(ReadDst));
+        }
+
+        private void Write()
+        {
+            var dst = (int)Get(WriteDst);
+            var cnt = (int)Get(WriteCnt);
+            var data = sysbus.ReadBytes(Get(WriteSrc), cnt);
+            for(var i = 0; i < cnt; i++) flash[(dst + i) % flash.Length] &= data[i];
+            dirty = true;
+        }
+
+        private void Erase()
+        {
+            var ptr = (int)Get(ErasePtr);
+            var len = Get(EraseLen);
+            int start, size;
+            if(len == 2) { start = 0; size = flash.Length; }
+            else { size = len == 1 ? 0x10000 : 0x1000; start = ptr & ~(size - 1); }
+            for(var i = 0; i < size && start + i < flash.Length; i++) flash[start + i] = 0xFF;
+            dirty = true;
+        }
+
+        private void CustomInstruction(uint conf)
+        {
+            var opcode = conf & 0xFF;
+            var length = (int)((conf >> 8) & 0xF);   // 1 = opcode only, n = opcode + (n-1) data bytes
+            var dataIn = new byte[8];
+            BitConverter.GetBytes(Get(CinstrDat0)).CopyTo(dataIn, 0);
+            BitConverter.GetBytes(Get(CinstrDat1)).CopyTo(dataIn, 4);
+            var dataOut = new byte[8];
+            switch(opcode)
+            {
+            case 0x9F:   // JEDEC ID
+                dataOut[0] = (byte)jedecId; dataOut[1] = (byte)(jedecId >> 8); dataOut[2] = (byte)(jedecId >> 16);
+                break;
+            case 0x05: dataOut[0] = sr1; break;
+            case 0x35: dataOut[0] = sr2; break;
+            case 0x01:   // write status (SR1 [SR2])
+                if(length >= 2) sr1 = (byte)(dataIn[0] & 0xFC);
+                if(length >= 3) sr2 = dataIn[1];
+                break;
+            case 0x31: if(length >= 2) sr2 = dataIn[0]; break;
+            case 0xC7:
+            case 0x60:
+                for(var i = 0; i < flash.Length; i++) flash[i] = 0xFF;
+                dirty = true;
+                break;
+            default:     // 0x06 WREN, 0x04 WRDI, 0xAB release DPD, 0xB9 DPD, 0x66/0x99 reset ...
+                break;
+            }
+            regs[CinstrDat0] = BitConverter.ToUInt32(dataOut, 0);
+            regs[CinstrDat1] = BitConverter.ToUInt32(dataOut, 4);
+        }
+
+        private readonly IBusController sysbus;
+        private readonly Dictionary<long, uint> regs = new Dictionary<long, uint>();
+        private readonly byte[] flash;
+        private readonly uint jedecId;
+        private byte sr1, sr2;
+        private string imagePath;
+        private System.Threading.Timer autosave;
+        private volatile bool dirty;
+
+        private const long TaskActivate = 0x000;
+        private const long TaskReadStart = 0x004;
+        private const long TaskWriteStart = 0x008;
+        private const long TaskEraseStart = 0x00C;
+        private const long TaskDeactivate = 0x010;
+        private const long EventReady = 0x100;
+        private const long IntEn = 0x300;
+        private const long IntEnSet = 0x304;
+        private const long IntEnClr = 0x308;
+        private const long ReadSrc = 0x504;
+        private const long ReadDst = 0x508;
+        private const long ReadCnt = 0x50C;
+        private const long WriteDst = 0x510;
+        private const long WriteSrc = 0x514;
+        private const long WriteCnt = 0x518;
+        private const long ErasePtr = 0x51C;
+        private const long EraseLen = 0x520;
+        private const long Status = 0x604;
+        private const long CinstrConf = 0x634;
+        private const long CinstrDat0 = 0x638;
+        private const long CinstrDat1 = 0x63C;
+    }
+}
