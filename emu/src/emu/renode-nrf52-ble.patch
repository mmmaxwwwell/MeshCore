diff --git a/src/Emulator/Main/Peripherals/Timers/ComparingTimer.cs b/src/Emulator/Main/Peripherals/Timers/ComparingTimer.cs
index f6919535e..b29104b5c 100644
--- a/src/Emulator/Main/Peripherals/Timers/ComparingTimer.cs
+++ b/src/Emulator/Main/Peripherals/Timers/ComparingTimer.cs
@@ -116,7 +116,12 @@ public ulong Value
                 var currentValue = 0UL;
                 clockSource.GetClockEntryInLockContext(CompareReachedInternal, entry =>
                 {
-                    currentValue = valueAccumulatedSoFar + entry.Value;
+                    // The entry can run past its period before CompareReachedInternal is scheduled;
+                    // that handler then adds only the period and restarts from 0, so reporting the
+                    // overshoot here made the value step BACKWARDS on the next read (an nRF52 RTC
+                    // COUNTER went 307 -> 306, and FreeRTOS's tick catch-up wrapped to ~2^24 ticks).
+                    // Hold at the compare point until the handler has run.
+                    currentValue = valueAccumulatedSoFar + Math.Min(entry.Value, entry.Period);
                 });
                 return currentValue;
             }
diff --git a/src/Emulator/Peripherals/Peripherals/Analog/NRF52840_SAADC.cs b/src/Emulator/Peripherals/Peripherals/Analog/NRF52840_SAADC.cs
new file mode 100644
index 000000000..49a7e0b74
--- /dev/null
+++ b/src/Emulator/Peripherals/Peripherals/Analog/NRF52840_SAADC.cs
@@ -0,0 +1,108 @@
+//
+// nRF52840 SAADC, minimal: every task completes instantly. SAMPLE writes
+// RESULT.MAXCNT 16-bit samples of SampleValue to RESULT.PTR and raises
+// END/DONE/RESULTDONE, which is all a polled analogRead() needs.
+//
+using System;
+using System.Collections.Generic;
+
+using Antmicro.Renode.Core;
+using Antmicro.Renode.Peripherals.Bus;
+
+namespace Antmicro.Renode.Peripherals.Analog
+{
+    public sealed class NRF52840_SAADC : IDoubleWordPeripheral, IKnownSize
+    {
+        public NRF52840_SAADC(IMachine machine)
+        {
+            sysbus = machine.GetSystemBus(this);
+            IRQ = new GPIO();
+        }
+
+        public long Size => 0x1000;
+        public GPIO IRQ { get; }
+
+        // Raw result returned for every channel (12-bit scale by default).
+        public short SampleValue { get; set; } = 2200;
+
+        public void Reset()
+        {
+            regs.Clear();
+            IRQ.Unset();
+        }
+
+        public uint ReadDoubleWord(long offset)
+        {
+            if(offset == IntEnSet || offset == IntEnClr) offset = IntEn;
+            if(offset == Status) return 0;   // ready
+            return regs.TryGetValue(offset, out var v) ? v : 0;
+        }
+
+        public void WriteDoubleWord(long offset, uint value)
+        {
+            switch(offset)
+            {
+            case TaskStart: if(value != 0) Fire(EvStarted); return;
+            case TaskSample:
+                if(value == 0) return;
+                var count = (int)Get(ResultMaxCnt);
+                var ptr = Get(ResultPtr);
+                for(var i = 0; i < count; i++)
+                {
+                    sysbus.WriteWord(ptr + (ulong)(2 * i), (ushort)SampleValue);
+                }
+                regs[ResultAmount] = (uint)count;
+                Fire(EvResultDone); Fire(EvDone); Fire(EvEnd);
+                return;
+            case TaskStop: if(value != 0) Fire(EvStopped); return;
+            case TaskCalibrate: if(value != 0) Fire(EvCalibrateDone); return;
+            case IntEnSet: regs[IntEn] = Get(IntEn) | value; Update(); return;
+            case IntEnClr: regs[IntEn] = Get(IntEn) & ~value; Update(); return;
+            default:
+                regs[offset] = value;
+                if(offset >= 0x100 && offset < 0x200 || offset == IntEn) Update();
+                return;
+            }
+        }
+
+        private uint Get(long o) => regs.TryGetValue(o, out var v) ? v : 0;
+
+        private void Fire(long ev)
+        {
+            regs[ev] = 1;
+            Update();
+        }
+
+        private void Update()
+        {
+            var en = Get(IntEn);
+            var on = false;
+            for(var i = 0; i < 22; i++)
+            {
+                if((en & (1u << i)) != 0 && Get(0x100 + 4 * i) != 0) on = true;
+            }
+            IRQ.Set(on);
+        }
+
+        private readonly IBusController sysbus;
+        private readonly Dictionary<long, uint> regs = new Dictionary<long, uint>();
+
+        private const long TaskStart = 0x000;
+        private const long TaskSample = 0x004;
+        private const long TaskStop = 0x008;
+        private const long TaskCalibrate = 0x00C;
+        private const long EvStarted = 0x100;
+        private const long EvEnd = 0x104;
+        private const long EvDone = 0x108;
+        private const long EvResultDone = 0x10C;
+        private const long EvCalibrateDone = 0x110;
+        private const long EvStopped = 0x114;
+        private const long IntEn = 0x300;
+        private const long IntEnSet = 0x304;
+        private const long IntEnClr = 0x308;
+        private const long Status = 0x400;
+        private const long ResultPtr = 0x62C;
+        private const long ResultMaxCnt = 0x630;
+        private const long ResultAmount = 0x634;
+    }
+}
diff --git a/src/Emulator/Peripherals/Peripherals/Miscellaneous/NRF52840_CCM.cs b/src/Emulator/Peripherals/Peripherals/Miscellaneous/NRF52840_CCM.cs
new file mode 100644
index 000000000..2bd506810
--- /dev/null
+++ b/src/Emulator/Peripherals/Peripherals/Miscellaneous/NRF52840_CCM.cs
@@ -0,0 +1,306 @@
+//
+// nRF52840 CCM + AAR (shared base 0x4000F000), modelled for BLE link
+// encryption in emulation. Not cycle accurate:
+//  - encrypt runs at the CRYPT task (the radio reads OUTPTR afterwards, at START);
+//  - decrypt is deferred to the radio's END event, when the received packet
+//    is in RAM (the hardware decrypts on the fly while receiving).
+// Packet layout in RAM: [S0 header][LENGTH][S1/RFU][payload][MIC].
+//
+using System;
+using System.Collections.Generic;
+using System.Security.Cryptography;
+
+using Antmicro.Renode.Core;
+using Antmicro.Renode.Logging;
+using Antmicro.Renode.Peripherals.Bus;
+using Antmicro.Renode.Peripherals.Wireless;
+
+namespace Antmicro.Renode.Peripherals.Miscellaneous
+{
+    public sealed class NRF52840_CCM : IDoubleWordPeripheral, IKnownSize, INRFEventProvider
+    {
+        public NRF52840_CCM(IMachine machine, NRF52840_Radio radio)
+        {
+            this.machine = machine;
+            sysbus = machine.GetSystemBus(this);
+            IRQ = new GPIO();
+            radio.EventTriggered += OnRadioEvent;
+            Reset();
+        }
+
+        public void Reset()
+        {
+            regs.Clear();
+            pendingDecrypt = false;
+            IRQ.Unset();
+        }
+
+        public long Size => 0x1000;
+        public GPIO IRQ { get; }
+        public event Action<uint> EventTriggered;
+
+        public uint ReadDoubleWord(long offset)
+        {
+            if(offset == IntEnClr) offset = IntEnSet;
+            return regs.TryGetValue(offset, out var v) ? v : 0;
+        }
+
+        public void WriteDoubleWord(long offset, uint value)
+        {
+            switch(offset)
+            {
+            case TaskKsgenOrAarStart:
+                if(value == 0) return;
+                if(AarMode) { RunAar(); }
+                else
+                {
+                    Fire(EvEndKsgen);
+                    if((Get(Shorts) & 1) != 0) { Crypt(); }
+                }
+                return;
+            case TaskCrypt:
+                if(value != 0 && !AarMode) Crypt();
+                return;
+            case TaskStop:
+                pendingDecrypt = false;
+                return;
+            case IntEnSet:
+                regs[IntEnSet] = Get(IntEnSet) | value;
+                Update();
+                return;
+            case IntEnClr:
+                regs[IntEnSet] = Get(IntEnSet) & ~value;
+                Update();
+                return;
+            default:
+                regs[offset] = value;
+                if(offset >= 0x100 && offset < 0x200) Update();
+                return;
+            }
+        }
+
+        private bool AarMode => (Get(Enable) & 3) == 3;
+        private uint Get(long o) => regs.TryGetValue(o, out var v) ? v : 0;
+
+        private void Fire(long ev)
+        {
+            regs[ev] = 1;
+            EventTriggered?.Invoke((uint)ev);
+            Update();
+        }
+
+        private void Update()
+        {
+            var en = Get(IntEnSet);
+            var on = false;
+            for(var i = 0; i < 3; i++)
+            {
+                if((en & (1u << i)) != 0 && Get(0x100 + i * 4) != 0) on = true;
+            }
+            IRQ.Set(on);
+        }
+
+        private void Crypt()
+        {
+            if((Get(Mode) & 1) == 0)
+            {
+                Encrypt();
+                Fire(EvEndCrypt);
+            }
+            else
+            {
+                pendingDecrypt = true;
+            }
+        }
+
+        private void OnRadioEvent(uint offset)
+        {
+            if(offset == RadioEventEnd && pendingDecrypt)
+            {
+                pendingDecrypt = false;
+                Decrypt();
+                Fire(EvEndCrypt);
+            }
+        }
+
+        private void LoadConfig(out byte[] key, out byte[] nonce)
+        {
+            var cnf = sysbus.ReadBytes(Get(CnfPtr), 33);
+            key = new byte[16];
+            Array.Copy(cnf, 0, key, 0, 16);
+            nonce = new byte[13];
+            Array.Copy(cnf, 16, nonce, 0, 5);
+            nonce[4] = (byte)((nonce[4] & 0x7F) | ((cnf[24] & 1) << 7));
+            Array.Copy(cnf, 25, nonce, 5, 8);
+        }
+
+        private void Encrypt()
+        {
+            var inPtr = Get(InPtr);
+            var outPtr = Get(OutPtr);
+            var hdr = sysbus.ReadBytes(inPtr, 3);
+            int len = hdr[1];
+            if(len == 0)
+            {
+                sysbus.WriteBytes(hdr, outPtr);
+                return;
+            }
+            var pt = sysbus.ReadBytes(inPtr + 3, len);
+            LoadConfig(out var key, out var nonce);
+            var ct = Ccm(key, nonce, (byte)(hdr[0] & 0xE3), pt, true, out var mic, null);
+            var output = new byte[3 + len + 4];
+            output[0] = hdr[0];
+            output[1] = (byte)(len + 4);
+            output[2] = hdr[2];
+            Array.Copy(ct, 0, output, 3, len);
+            Array.Copy(mic, 0, output, 3 + len, 4);
+            sysbus.WriteBytes(output, outPtr);
+            this.Log(LogLevel.Debug, "CCM encrypt len={0}", len);
+        }
+
+        private void Decrypt()
+        {
+            var inPtr = Get(InPtr);
+            var outPtr = Get(OutPtr);
+            var hdr = sysbus.ReadBytes(inPtr, 3);
+            int len = hdr[1];
+            if(len == 0)
+            {
+                sysbus.WriteBytes(hdr, outPtr);
+                regs[MicStatus] = 1;
+                return;
+            }
+            if(len < 5)
+            {
+                regs[MicStatus] = 0;
+                Fire(EvError);
+                return;
+            }
+            var data = sysbus.ReadBytes(inPtr + 3, len);
+            var ct = new byte[len - 4];
+            Array.Copy(data, 0, ct, 0, len - 4);
+            var micIn = new byte[4];
+            Array.Copy(data, len - 4, micIn, 0, 4);
+            LoadConfig(out var key, out var nonce);
+            var pt = Ccm(key, nonce, (byte)(hdr[0] & 0xE3), ct, false, out var mic, micIn);
+            var ok = mic[0] == micIn[0] && mic[1] == micIn[1] && mic[2] == micIn[2] && mic[3] == micIn[3];
+            regs[MicStatus] = ok ? 1u : 0u;
+            var output = new byte[3 + len - 4];
+            output[0] = hdr[0];
+            output[1] = (byte)(len - 4);
+            output[2] = hdr[2];
+            Array.Copy(pt, 0, output, 3, len - 4);
+            sysbus.WriteBytes(output, outPtr);
+            this.Log(ok ? LogLevel.Debug : LogLevel.Warning, "CCM decrypt len={0} mic={1}", len - 4, ok ? "ok" : "FAIL");
+        }
+
+        // AES-CCM, RFC 3610 with M=4, L=2, 1 byte of AAD (the BLE profile).
+        private static byte[] Ccm(byte[] key, byte[] nonce, byte aad, byte[] input, bool encrypt, out byte[] mic, byte[] micIn)
+        {
+            using(var aes = Aes.Create())
+            {
+                aes.Key = key;
+                Func<byte[], byte[]> E = b => aes.EncryptEcb(b, PaddingMode.None);
+                var n = input.Length;
+                var output = new byte[n];
+                // CTR
+                for(int i = 0, blk = 1; i < n; i += 16, blk++)
+                {
+                    var a = new byte[16];
+                    a[0] = 0x01;
+                    Array.Copy(nonce, 0, a, 1, 13);
+                    a[14] = (byte)(blk >> 8);
+                    a[15] = (byte)blk;
+                    var s = E(a);
+                    for(var j = 0; j < 16 && i + j < n; j++) output[i + j] = (byte)(input[i + j] ^ s[j]);
+                }
+                var plain = encrypt ? input : output;
+                // CBC-MAC
+                var b0 = new byte[16];
+                b0[0] = 0x49;
+                Array.Copy(nonce, 0, b0, 1, 13);
+                b0[14] = (byte)(n >> 8);
+                b0[15] = (byte)n;
+                var x = E(b0);
+                var b1 = new byte[16];
+                b1[1] = 1;
+                b1[2] = aad;
+                for(var j = 0; j < 16; j++) b1[j] ^= x[j];
+                x = E(b1);
+                for(var i = 0; i < n; i += 16)
+                {
+                    var blk = (byte[])x.Clone();
+                    for(var j = 0; j < 16 && i + j < n; j++) blk[j] ^= plain[i + j];
+                    x = E(blk);
+                }
+                var a0 = new byte[16];
+                a0[0] = 0x01;
+                Array.Copy(nonce, 0, a0, 1, 13);
+                var s0 = E(a0);
+                mic = new byte[4];
+                for(var j = 0; j < 4; j++) mic[j] = (byte)(x[j] ^ s0[j]);
+                return output;
+            }
+        }
+
+        // AAR: resolve the address at ADDRPTR (+3: after S0/LENGTH/S1) against NIRK IRKs.
+        private void RunAar()
+        {
+            var nirk = (int)Math.Min(Get(AarNirk) & 0x1F, 16);
+            var addr = sysbus.ReadBytes(Get(AarAddrPtr) + 3, 6);
+            var resolved = -1;
+            using(var aes = Aes.Create())
+            {
+                for(var i = 0; i < nirk && resolved < 0; i++)
+                {
+                    aes.Key = sysbus.ReadBytes(Get(AarIrkPtr) + (ulong)(16 * i), 16);
+                    var r = new byte[16];
+                    r[13] = addr[5];
+                    r[14] = addr[4];
+                    r[15] = addr[3];
+                    var h = aes.EncryptEcb(r, PaddingMode.None);
+                    if(h[15] == addr[0] && h[14] == addr[1] && h[13] == addr[2]) resolved = i;
+                }
+            }
+            if(resolved >= 0)
+            {
+                regs[AarStatus] = (uint)resolved;
+                Fire(EvAarResolved);
+            }
+            else
+            {
+                Fire(EvAarNotResolved);
+            }
+            Fire(EvAarEnd);
+        }
+
+        private readonly IMachine machine;
+        private readonly IBusController sysbus;
+        private readonly Dictionary<long, uint> regs = new Dictionary<long, uint>();
+        private bool pendingDecrypt;
+
+        private const long TaskKsgenOrAarStart = 0x000;
+        private const long TaskCrypt = 0x004;
+        private const long TaskStop = 0x008;
+        private const long EvEndKsgen = 0x100;
+        private const long EvEndCrypt = 0x104;
+        private const long EvError = 0x108;
+        private const long EvAarEnd = 0x100;
+        private const long EvAarResolved = 0x104;
+        private const long EvAarNotResolved = 0x108;
+        private const long Shorts = 0x200;
+        private const long IntEnSet = 0x304;
+        private const long IntEnClr = 0x308;
+        private const long MicStatus = 0x400;
+        private const long AarStatus = 0x400;
+        private const long Enable = 0x500;
+        private const long Mode = 0x504;
+        private const long AarNirk = 0x504;
+        private const long CnfPtr = 0x508;
+        private const long AarIrkPtr = 0x508;
+        private const long InPtr = 0x50C;
+        private const long OutPtr = 0x510;
+        private const long AarAddrPtr = 0x510;
+        private const uint RadioEventEnd = 0x10C;
+    }
+}
